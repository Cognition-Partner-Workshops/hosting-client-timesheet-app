{
  "name": "hosting-client-timesheet-app",
  "version": "1.0.0",
  "description": "Hosting configuration and tests for client timesheet application",
  "main": "docker/overrides/server.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --coverage --ci --maxWorkers=2",
