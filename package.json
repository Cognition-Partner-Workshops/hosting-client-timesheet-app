{
  "name": "hosting-client-timesheet-app",
  "version": "1.0.0",
  "description": "Infrastructure and deployment configuration for client timesheet application",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "express": "^4.18.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "sqlite3": "^5.1.6",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "express-rate-limit": "^7.1.5"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/docker/overrides/__tests__/**/*.test.js"],
    "collectCoverageFrom": [
      "docker/overrides/**/*.js",
      "!docker/overrides/__tests__/**"
    ],
    "coverageDirectory": "coverage",
    "verbose": true
  }
}
