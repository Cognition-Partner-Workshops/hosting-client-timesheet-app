    "validate:terraform": "cd terraform/bootstrap && terraform validate && cd ../infrastructure && terraform validate"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  },
  "keywords": [
    "hosting",
    "timesheet",
    "docker",
    "terraform"
  ],
